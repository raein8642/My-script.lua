-- FPS COUNTER
local frames = 0
local lastUpdate = os.clock()

local statsConnection = RunService.RenderStepped:Connect(function()
frames += 1

if os.clock() - lastUpdate >= 1 then
local fps = frames
frames = 0
lastUpdate = os.clock()

if gui.Parent then    
    stats.Text = "FPS: " .. fps ..    
        "  |  TIME: " .. os.date("%H:%M:%S")    
end

end

end)

