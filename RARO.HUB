local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 5)
layout.Parent = scroll

local currentTrack = nil
local currentAnimation = nil
local currentIndex = nil
local danceButtons = {}

local function stopDance()
if currentTrack then
currentTrack:Stop()
currentTrack:Destroy()
currentTrack = nil
end

if currentAnimation then
currentAnimation:Destroy()
currentAnimation = nil
end

currentIndex = nil

for _, b in ipairs(danceButtons) do
if b.Parent then
b.BackgroundColor3 = Color3.fromRGB(15, 45, 75)
end
end

end

local function playDance(index, button)
if currentIndex == index then
stopDance()
return
end

stopDance()

local character = player.Character
local humanoid = character and
character:FindFirstChildOfClass("Humanoid")

if not humanoid then
status.Text = "ERROR // CHARACTER NOT FOUND"
return
end

if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
status.Text = "ERROR // R6 CHARACTER REQUIRED"
return
end

local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
status.Text = "ERROR // ANIMATOR NOT FOUND"
return
end

local animation = Instance.new("Animation")
animation.AnimationId = "rbxassetid://" .. DANCES[index].id

local success, track = pcall(function()
return animator:LoadAnimation(animation)
end)

if not success then
animation:Destroy()
status.Text = "ERROR // ANIMATION FAILED"
return
end

currentAnimation = animation
currentTrack = track
currentTrack.Looped = true
currentTrack:Play()
currentIndex = index

button.BackgroundColor3 = GREEN
status.Text = "SYSTEM // DANCE ACTIVE"

end

local function buildDanceButtons()
for _, b in ipairs(danceButtons) do
b:Destroy()
end
table.clear(danceButtons)

for i, dance in ipairs(DANCES) do
if string.find(
string.lower(dance.name),
string.lower(search.Text),
1,
true
) then
local b = makeButton(
scroll,
dance.name,
UDim2.new(),
UDim2.new(1, -5, 0, 34)
)

b.LayoutOrder = i    
    table.insert(danceButtons, b)    

    if currentIndex == i then    
        b.BackgroundColor3 = GREEN    
    end    

    b.MouseButton1Click:Connect(function()    
        playDance(i, b)    
    end)    
end

end

end

buildDanceButtons()

search:GetPropertyChangedSignal("Text"):Connect(buildDanceButtons)

local stopButton = makeButton(
dancePanel, "STOP DANCE",
UDim2.new(0, 8, 1, -40),
UDim2.new(1, -16, 0, 32)
)

stopButton.BackgroundColor3 = Color3.fromRGB(130, 30, 45)

stopButton.MouseButton1Click:Connect(function()
stopDance()
status.Text = "SYSTEM // DANCE STOPPED"
end)

danceOpen.MouseButton1Click:Connect(function()
dancePanel.Visible = not dancePanel.Visible
end)

danceClose.MouseButton1Click:Connect(function()
dancePanel.Visible = false
end)

-- SHANGOOL SODA
local soda = nil
local effectActive = false
local effectConnection = nil

local function stopSodaEffect()
if effectConnection then
effectConnection:Disconnect()
effectConnection = nil
end

local camera = workspace.CurrentCamera
if camera then
camera.FieldOfView = 70
end

local character = player.Character
local humanoid = character and
character:FindFirstChildOfClass("Humanoid")

if humanoid then
humanoid.CameraOffset = Vector3.zero
end

effectActive = false

end

local function startSodaEffect()
if effectActive then return end

local camera = workspace.CurrentCamera
if not camera then return end

effectActive = true

local originalFOV = camera.FieldOfView
local startTime = os.clock()
local duration = 2.5

effectConnection = RunService.RenderStepped:Connect(function()
local elapsed = os.clock() - startTime

if elapsed >= duration then    
    stopSodaEffect()    
    return    
end    

camera = workspace.CurrentCamera    
if not camera then    
    stopSodaEffect()    
    return    
end    

local wave = math.sin(elapsed * 4)    

camera.FieldOfView = originalFOV + wave * 2    

local character = player.Character    
local humanoid = character and    
    character:FindFirstChildOfClass("Humanoid")    

if humanoid then    
    humanoid.CameraOffset = Vector3.new(    
        math.sin(elapsed * 3) * .07,    
        math.cos(elapsed * 4) * .05,    
        0    
    )    
end

end)

end

local function createSoda()
local tool = Instance.new("Tool")
tool.Name = "Shangool Soda"
tool.RequiresHandle = true
tool.CanBeDropped = false

local handle = Instance.new("Part")
handle.Name = "Handle"
handle.Size = Vector3.new(.6, 1.5, .6)
handle.Color = Color3.fromRGB(220, 20, 35)
handle.Material = Enum.Material.SmoothPlastic
handle.CanCollide = false
handle.Parent = tool

local cap = Instance.new("Part")
cap.Name = "Cap"
cap.Size = Vector3.new(.62, .12, .62)
cap.Color = Color3.fromRGB(180, 180, 190)
cap.Material = Enum.Material.Metal
cap.CanCollide = false
cap.Massless = true
cap.CFrame = handle.CFrame * CFrame.new(0, .8, 0)
cap.Parent = tool

local weld = Instance.new("WeldConstraint")
weld.Part0 = handle
weld.Part1 = cap
weld.Parent = handle

tool.Activated:Connect(function()
startSodaEffect()
end)

return tool

end

sodaButton.MouseButton1Click:Connect(function()
local backpack = player:FindFirstChild("Backpack")
if not backpack then return end

if soda and soda.Parent then
local character = player.Character

if soda.Parent == character then    
    soda.Parent = backpack    
    sodaButton.Text = ">> SHANGOOL SODA"    
else    
    local humanoid = character and    
        character:FindFirstChildOfClass("Humanoid")    

    if humanoid then    
        humanoid:EquipTool(soda)    
        sodaButton.Text = ">> SODA EQUIPPED"    
    end    
end    

return

end

soda = createSoda()
soda.Parent = backpack

local character = player.Character
local humanoid = character and
character:FindFirstChildOfClass("Humanoid")

if humanoid then
humanoid:EquipTool(soda)
end

sodaButton.Text = ">> SODA EQUIPPED"
status.Text = "SYSTEM // SODA READY"

end)

-- HACKER SCAN
local scan = Instance.new("Frame")
scan.Size = UDim2.new(1, 0, 0, 2)
scan.BackgroundColor3 = BLUE
scan.BackgroundTransparency = .25
scan.BorderSizePixel = 0
scan.ZIndex = 5
scan.Parent = main

task.spawn(function()
while gui.Parent do
scan.Position = UDim2.new(0, 0, 0, 42)

local tween = TweenService:Create(
scan,
TweenInfo.new(2.5, Enum.EasingStyle.Linear),
{Position = UDim2.new(0, 0, 1, -3)}
)

tween:Play()    
tween.Completed:Wait()    
task.wait(.2)

end

end)

-- NEON BORDER
task.spawn(function()
while gui.Parent do
local hue = .55 + math.sin(os.clock()) * .035
mainStroke.Color = Color3.fromHSV(hue, .85, 1)
task.wait(.04)
end
end)

-- RESPAWN SUPPORT
player.CharacterAdded:Connect(function()
stopDance()
stopSodaEffect()

soda = nil
sodaButton.Text = ">> SHANGOOL MODE"
status.Text = "SYSTEM ONLINE // RARO USER"

end)

-- CLEANUP
gui.Destroying:Connect(function()
stopDance()
stopSodaEffect()

if statsConnection then
statsConnection:Disconnect()
end

end)

print("RARO.HUB HACKER EDITION LOADED!")
