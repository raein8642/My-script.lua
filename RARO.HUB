-- MAIN GUI
local gui = Instance.new("ScreenGui")
gui.Name = "RaroHub"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.Parent = playerGui

-- UI HELPERS
local function corner(obj, radius)
local c = Instance.new("UICorner")
c.CornerRadius = UDim.new(0, radius or 8)
c.Parent = obj
end

local function addStroke(obj, color, thickness)
local s = Instance.new("UIStroke")
s.Color = color or BLUE
s.Thickness = thickness or 1
s.Parent = obj
return s
end

local function makeButton(parent, text, position, size)
local b = Instance.new("TextButton")
b.Size = size
b.Position = position
b.BackgroundColor3 = Color3.fromRGB(15, 45, 75)
b.Text = text
b.TextColor3 = WHITE
b.TextSize = 13
b.Font = Enum.Font.GothamBold
b.AutoButtonColor = false
b.Parent = parent
corner(b, 7)

b.MouseEnter:Connect(function()
TweenService:Create(b, TweenInfo.new(.15), {
BackgroundColor3 = Color3.fromRGB(20, 100, 165)
}):Play()
end)

b.MouseLeave:Connect(function()
TweenService:Create(b, TweenInfo.new(.15), {
BackgroundColor3 = Color3.fromRGB(15, 45, 75)
}):Play()
end)

return b

end

