TweenService:Create(introTitle, TweenInfo.new(.8), {
TextTransparency = 0
}):Play()

task.wait(.8)

TweenService:Create(introSub, TweenInfo.new(.5), {
TextTransparency = 0
}):Play()

TweenService:Create(loadingBar, TweenInfo.new(2), {
Size = UDim2.fromScale(1, 1)
}):Play()

task.wait(2.1)

introSub.Text = "SYSTEM ONLINE // WELCOME"

task.wait(.7)

TweenService:Create(introBG, TweenInfo.new(.6), {
BackgroundTransparency = 1
}):Play()

TweenService:Create(introTitle, TweenInfo.new(.5), {
TextTransparency = 1
}):Play()

TweenService:Create(introSub, TweenInfo.new(.5), {
TextTransparency = 1
}):Play()

task.wait(.7)
